<?xml version="1.0" encoding="UTF-8"?>

<sdf version="1.6">

    <!-- ====================================== -->
    <!-- RMUL 2027 Gazebo 仿真比赛场地 -->
    <!-- Gazebo Classic 11 -->
    <!-- ====================================== -->

    <world name="rmul_2027">

        <!-- ================================== -->
        <!-- 1. 物理引擎 -->
        <!-- ================================== -->

        <physics name="default_physics" type="ode">

            <!-- 物理仿真步长 -->
            <max_step_size>0.001</max_step_size>

            <!-- 实时仿真比例 -->
            <real_time_factor>1.0</real_time_factor>

        </physics>


        <!-- ================================== -->
        <!-- 2. 太阳光 -->
        <!-- ================================== -->

        <include>
            <uri>model://sun</uri>
        </include>


        <!-- ================================== -->
        <!-- 3. 基础地面 -->
        <!-- ================================== -->

        <include>
            <uri>model://ground_plane</uri>
        </include>


        <!-- ================================== -->
        <!-- 4. RMUL 2027 比赛场地 -->
        <!-- ================================== -->

        <model name="rmul_2027_arena">

            <!-- 静态场地，不受重力影响 -->
            <static>true</static>


            <!-- ============================== -->
            <!-- 5. 场地位置与旋转 -->
            <!-- ============================== -->

            <!--
                STL 原始坐标：

                X = 0 ~ 12600
                Y = 0 ~ 520
                Z = 0 ~ 8600

                假设 STL 以毫米为单位。

                换算为米：

                长度：12.6 m
                宽度：8.6 m
                高度：0.52 m

                模型原始高度方向为 Y 轴。

                Gazebo 以 Z 轴为高度方向。

                绕 X 轴旋转 -90 度。

                模型位置：

                X = -6.3
                Y = -4.3
                Z = 0.52

                Roll = -1.57079632679
                Pitch = 0
                Yaw = 0
            -->

            <pose>-6.3 -4.3 0.52 -1.57079632679 0 0</pose>


            <!-- ============================== -->
            <!-- 6. 场地 Link -->
            <!-- ============================== -->

            <link name="arena_link">


                <!-- ========================== -->
                <!-- 7. STL 视觉模型 -->
                <!-- ========================== -->

                <visual name="arena_visual">

                    <geometry>

                        <mesh>

                            <!-- STL 场地路径 -->
                            <uri>file:///home/ethan/RoboVigor/gazebo_arena/meshes/rmul_2027.stl</uri>

                            <!-- 毫米转换为米 -->
                            <scale>0.001 0.001 0.001</scale>

                        </mesh>

                    </geometry>


                    <!-- ====================== -->
                    <!-- 8. 场地材质 -->
                    <!-- ====================== -->

                    <material>

                        <!-- 环境光 -->
                        <ambient>0.7 0.7 0.7 1</ambient>

                        <!-- 漫反射 -->
                        <diffuse>0.8 0.8 0.8 1</diffuse>

                        <!-- 镜面反射 -->
                        <specular>0.1 0.1 0.1 1</specular>

                        <!-- 自发光 -->
                        <emissive>0 0 0 1</emissive>

                    </material>

                </visual>


                <!-- ========================== -->
                <!-- 9. STL 碰撞模型 -->
                <!-- ========================== -->

                <collision name="arena_collision">

                    <geometry>

                        <mesh>

                            <!-- 碰撞 STL 文件 -->
                            <uri>file:///home/ethan/RoboVigor/gazebo_arena/meshes/rmul_2027.stl</uri>

                            <!-- 与视觉模型保持一致 -->
                            <scale>0.001 0.001 0.001</scale>

                        </mesh>

                    </geometry>


                    <!-- ====================== -->
                    <!-- 10. 物理接触参数 -->
                    <!-- ====================== -->

                    <surface>

                        <friction>

                            <ode>

                                <!-- 第一方向摩擦系数 -->
                                <mu>1.0</mu>

                                <!-- 第二方向摩擦系数 -->
                                <mu2>1.0</mu2>

                            </ode>

                        </friction>

                        <contact>

                            <ode>

                                <!-- 最大接触修正速度 -->
                                <max_vel>0.1</max_vel>

                                <!-- 最小接触深度 -->
                                <min_depth>0.001</min_depth>

                            </ode>

                        </contact>

                    </surface>

                </collision>

            </link>

        </model>

    </world>

</sdf>
