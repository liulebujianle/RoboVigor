<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sentry_navigation</name>
  <version>0.1.0</version>
  <description>RMUL 2027 哨兵导航：Nav2 / SLAM / 定位的启动与配置。只放配置与 launch，不实现算法。</description>

  <maintainer email="hhhrrrppp123654@gmail.com">ethan</maintainer>

  <license>Apache-2.0</license>

  <!-- 编译期依赖：本包是 ament_python，只有 Python 代码与 launch -->
  <depend>rclpy</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>ament_index_python</depend>
  <depend>tf2_ros</depend>

  <!-- 运行期依赖：launch 里会 exec 这些包的可执行文件，本包自己不需要 import 它们 -->
  <exec_depend>rviz2</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>pointcloud_to_laserscan</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
