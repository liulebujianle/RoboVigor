<?xml version='1.0' encoding='utf-8'?>
<!--
  车体模型（纯 URDF，不含任何 Gazebo 内容）。
  结构：base_link → chassis_link → 4 个全向轮 wheel_N_link → 每轮 28 个被动滚子 roller_NNN_link。
  112 个滚子形状完全一致、只有位姿/轴线/质心/半径不同，因此统一由 cad_roller 宏生成；
  注释里的数值全部来自 CAD 导出（tools/import_sentry_cad.py），不要手改。
-->
<robot name="robovigor_sentry" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================= 常量区 ================= -->
  <xacro:property name="cad_mesh" value="package://sentry_description/meshes"/>
  <xacro:property name="roller_mass" value="0.00446428571429"/>
  <xacro:property name="roller_effort" value="0.1"/>
  <xacro:property name="roller_velocity" value="1000"/>
  <xacro:property name="roller_damping" value="0.000001"/>
  <xacro:property name="wheel_mass" value="0.25"/>
  <xacro:property name="wheel_ixx" value="0.000251041666667"/>
  <xacro:property name="wheel_izz" value="0.000189583333333"/>
  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_length" value="0.04"/>

  <!-- ================= 宏 ================= -->
  <!-- 纯外观：CAD 网格 + 统一灰色材质（无 <color> 子元素，RViz 直接用默认色）。 -->
  <xacro:macro name="cad_visual" params="file">
    <visual>
      <geometry>
        <mesh filename="${cad_mesh}/${file}"/>
      </geometry>
      <material name="cad_gray"/>
    </visual>
  </xacro:macro>

  <!-- 一个被动滚子 = 1 个 link + 1 个 continuous 关节。
       碰撞体是包住滚子的球，惯量按球近似，球心/质心用 CAD 的 com。 -->
  <xacro:macro name="cad_roller" params="id parent xyz axis com r i">
    <link name="roller_${id}_link">
      <xacro:cad_visual file="roller_${id}_link.stl"/>
      <inertial>
        <mass value="${roller_mass}"/>
        <origin xyz="${com}"/>
        <inertia ixx="${i}" iyy="${i}" izz="${i}" ixy="0" ixz="0" iyz="0"/>
      </inertial>
      <collision>
        <geometry>
          <sphere radius="${r}"/>
        </geometry>
        <origin xyz="${com}"/>
      </collision>
    </link>
    <joint name="roller_${id}_joint" type="continuous">
      <parent link="${parent}"/>
      <child link="roller_${id}_link"/>
      <origin xyz="${xyz}"/>
      <axis xyz="${axis}"/>
      <limit effort="${roller_effort}" velocity="${roller_velocity}"/>
      <dynamics damping="${roller_damping}" friction="0"/>
    </joint>
  </xacro:macro>

  <!-- 一个全向轮 = 1 个 link + 1 个 continuous 关节；碰撞体是包住轮子的圆柱。 -->
  <xacro:macro name="cad_wheel" params="n xyz axis rpy ixy">
    <link name="wheel_${n}_link">
      <xacro:cad_visual file="wheel_${n}_link.stl"/>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${wheel_ixx}" iyy="${wheel_ixx}" izz="${wheel_izz}"
                 ixy="${ixy}" ixz="0" iyz="0"/>
      </inertial>
      <collision>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="${rpy}"/>
      </collision>
    </link>
    <joint name="wheel_${n}_joint" type="continuous">
      <parent link="chassis_link"/>
      <child link="wheel_${n}_link"/>
      <origin xyz="${xyz}"/>
      <axis xyz="${axis}"/>
      <limit effort="1.2" velocity="1000"/>
      <dynamics damping="0.0001" friction="0"/>
    </joint>
  </xacro:macro>

  <!-- ================= 车体（单个实例，直接写死） ================= -->
  <link name="base_link"/>
  <joint name="chassis_fixed" type="fixed">
    <parent link="base_link"/>
    <child link="chassis_link"/>
  </joint>
  <link name="chassis_link">
    <visual>
      <geometry>
        <mesh filename="${cad_mesh}/chassis.stl"/>
      </geometry>
      <material name="cad_gray">
        <color rgba="0.48 0.51 0.55 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.30 0.30 0.08"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.013000"/>
      <mass value="6.5"/>
      <inertia ixx="0.179616667" iyy="0.179616667" izz="0.3159" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ================= 四个全向轮 ================= -->
  <xacro:cad_wheel n="1" xyz="-0.16731710127 0.16731710127 -0.0362828401707"
                   axis="0.707106781187 -0.707106781187 0" rpy="0 1.5707963267948966 -0.7853981633974483" ixy="-6.14583333333e-05"/>
  <xacro:cad_wheel n="2" xyz="0.16731710127 0.16731710127 -0.0362828401707"
                   axis="-0.707106781187 -0.707106781187 0" rpy="0 1.5707963267948966 -2.356194490192345" ixy="6.14583333333e-05"/>
  <xacro:cad_wheel n="3" xyz="0.16731710127 -0.16731710127 -0.0362828401707"
                   axis="-0.707106781187 0.707106781187 0" rpy="0 1.5707963267948966 2.356194490192345" ixy="-6.14583333333e-05"/>
  <xacro:cad_wheel n="4" xyz="-0.16731710127 -0.16731710127 -0.0362828401707"
                   axis="0.707106781187 0.707106781187 0" rpy="0 1.5707963267948966 0.7853981633974483" ixy="6.14583333333e-05"/>

  <!-- ================= 112 个被动滚子：每行一个，字段 = 序号 父轮 关节原点 轴线 质心 球半径 惯量 ================= -->
  <!-- 挂在 wheel_1_link 上的 28 个 -->
  <xacro:cad_roller id="001" parent="wheel_1_link" xyz="-0.0328458544824 -0.0165823985151 -0.0569774201136" axis="0.648107386505 0.648107386505 -0.39989202432" com="0.00599499324789 0.00599499324789 -0.00369900117728" r="0.00990000042851228" i="1.75017872294e-07"/>
