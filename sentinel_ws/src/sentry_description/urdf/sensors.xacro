<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Mechanical CAD references, not measured camera/Livox driver calibration. -->
  <xacro:property name="frame_data" value="${xacro.load_yaml('$(find sentry_description)/config/frames.yaml')['frames']}"/>
  <xacro:macro name="reference_frame" params="name">
    <link name="${name}">
      <xacro:if value="${name in ['lidar_link', 'lidar_aux_link']}">
        <visual>
          <origin xyz="0 0 0.025"/>
          <geometry><cylinder radius="0.032" length="0.05"/></geometry>
          <material name="lidar_yellow"><color rgba="0.85 0.65 0.15 1"/></material>
        </visual>
      </xacro:if>
      <xacro:if value="${name == 'camera_link'}">
        <visual>
          <origin xyz="-0.015 0 0"/>
          <geometry><box size="0.04 0.04 0.035"/></geometry>
          <material name="camera_dark"><color rgba="0.12 0.12 0.14 1"/></material>
        </visual>
        <visual>
          <origin xyz="0.02 0 0" rpy="0 1.5707963267948966 0"/>
          <geometry><cylinder radius="0.01" length="0.03"/></geometry>
          <material name="lens_blue"><color rgba="0.1 0.6 0.85 1"/></material>
        </visual>
      </xacro:if>
      <xacro:if value="${name == 'gun_link'}">
        <visual>
          <origin xyz="0.072082129185 0 0" rpy="0 1.5707963267948966 0"/>
          <geometry><cylinder radius="0.014" length="0.14416425837"/></geometry>
          <material name="gun_gray"><color rgba="0.22 0.24 0.26 1"/></material>
        </visual>
      </xacro:if>
    </link>
    <joint name="${name}_fixed" type="fixed">
      <parent link="${frame_data[name]['parent']}"/>
      <child link="${name}"/>
      <origin xyz="${frame_data[name]['xyz']}" rpy="${frame_data[name]['rpy']}"/>
    </joint>
  </xacro:macro>
  <xacro:reference_frame name="lidar_link"/>
  <xacro:reference_frame name="lidar_aux_link"/>
  <xacro:reference_frame name="camera_link"/>
  <xacro:reference_frame name="camera_optical_frame"/>
  <xacro:reference_frame name="gun_link"/>
  <xacro:reference_frame name="muzzle_link"/>
</robot>
