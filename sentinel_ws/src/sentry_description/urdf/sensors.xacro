<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Mechanical references; Odin1 Lite mount is a simulation placeholder, not calibration. -->
  <xacro:property name="frame_data" value="${xacro.load_yaml('$(find sentry_description)/config/frames.yaml')['frames']}"/>
  <!-- Simulation pitch pivot reuses the original gun reference exactly at q=0.
       The CAD YAML and the nominal lidar/camera mounts remain unchanged. -->
  <link name="gimbal_pitch_link">
    <inertial>
      <!-- Simulation-only 0.25 kg barrel approximation, not measured hardware. -->
      <origin xyz="0.072082129185 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="0.0000245" iyy="0.00044523" izz="0.00044523"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="gimbal_pitch_joint" type="revolute">
    <parent link="gimbal_yaw_link"/>
    <child link="gimbal_pitch_link"/>
    <origin xyz="${frame_data['gun_link']['xyz']}" rpy="${frame_data['gun_link']['rpy']}"/>
    <axis xyz="0 1 0"/>
    <!-- +/-90 joint travel accommodates the +18.13 degree CAD nominal pitch.
         The FPS command is separately limited to +/-60 degrees world pitch. -->
    <limit lower="-1.5707963267948966" upper="1.5707963267948966" effort="1" velocity="6"/>
    <dynamics damping="0.002" friction="0"/>
  </joint>
  <xacro:macro name="reference_frame" params="name">
    <link name="${name}">
      <!-- One active Odin1 Lite. Auxiliary frame remains a compatibility alias only.
           Approximate housing: X depth58mm, Y width69mm, Z height69mm.
           Base-centered visual origin is an assumption, not a measured optical offset. -->
      <xacro:if value="${name == 'lidar_link'}">
        <visual>
          <origin xyz="0 0 0.0345"/>
          <geometry><box size="0.058 0.069 0.069"/></geometry>
          <material name="odin1_lite_dark"><color rgba="0.12 0.13 0.15 1"/></material>
        </visual>
      </xacro:if>
      <xacro:if value="${name == 'camera_link'}">
        <visual>
          <origin xyz="-0.015 0 0"/>
          <geometry><box size="0.04 0.04 0.035"/></geometry>
          <material name="camera_dark"><color rgba="0.12 0.12 0.14 1"/></material>
        </visual>
        <visual>
          <origin xyz="0.02 0 0" rpy="0 1.5707963267948966 0"/>
          <geometry><cylinder radius="0.01" length="0.03"/></geometry>
          <material name="lens_blue"><color rgba="0.1 0.6 0.85 1"/></material>
        </visual>
      </xacro:if>
      <xacro:if value="${name == 'gun_link'}">
        <visual>
          <origin xyz="0.072082129185 0 0" rpy="0 1.5707963267948966 0"/>
          <geometry><cylinder radius="0.014" length="0.14416425837"/></geometry>
          <material name="gun_gray"><color rgba="0.22 0.24 0.26 1"/></material>
        </visual>
      </xacro:if>
    </link>
    <joint name="${name}_fixed" type="fixed">
      <xacro:if value="${name == 'gun_link'}">
        <parent link="gimbal_pitch_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:if>
      <xacro:unless value="${name == 'gun_link'}">
        <parent link="${frame_data[name]['parent']}"/>
        <origin xyz="${frame_data[name]['xyz']}" rpy="${frame_data[name]['rpy']}"/>
      </xacro:unless>
      <child link="${name}"/>
    </joint>
  </xacro:macro>
  <xacro:reference_frame name="lidar_link"/>
  <xacro:reference_frame name="lidar_aux_link"/>
  <xacro:reference_frame name="camera_link"/>
  <xacro:reference_frame name="camera_optical_frame"/>
  <xacro:reference_frame name="gun_link"/>
  <xacro:reference_frame name="muzzle_link"/>
  <!-- Additional FPS aliases: +X is the barrel direction; sensor uses that
       same pose on the massive pitch link, surviving Gazebo fixed lumping. -->
  <xacro:property name="fps_camera_x" value="${float(frame_data['muzzle_link']['xyz'].split()[0]) + 0.02}"/>
  <link name="fps_camera_link"/>
  <joint name="fps_camera_fixed" type="fixed">
    <parent link="muzzle_link"/><child link="fps_camera_link"/>
    <origin xyz="0.02 0 0" rpy="0 0 0"/>
  </joint>
  <link name="fps_camera_optical_frame"/>
  <joint name="fps_camera_optical_fixed" type="fixed">
    <parent link="fps_camera_link"/><child link="fps_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966"/>
  </joint>
</robot>
