<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Attach to the massive moving link, not a massless fixed alias which
       Gazebo can lump. Local +X matches gun_link and the muzzle exactly. -->
  <gazebo reference="gimbal_pitch_link">
    <sensor name="fps_camera" type="camera">
      <pose>${fps_camera_x} 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>30</update_rate>
      <camera name="fps_camera">
        <horizontal_fov>1.3962634015954636</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.01</near><far>100</far></clip>
      </camera>
      <plugin name="fps_camera_ros" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/</namespace>
          <!-- ROS 2 prefixes these topics with camera_name before remapping. -->
          <remapping>fps/image_raw:=/fps/image_raw</remapping>
          <remapping>fps/camera_info:=/fps/camera_info</remapping>
        </ros>
        <camera_name>fps</camera_name>
        <frame_name>fps_camera_optical_frame</frame_name>
      </plugin>
    </sensor>
  </gazebo>
</robot>
