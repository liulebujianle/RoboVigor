<?xml version='1.0' encoding='utf-8'?>
<!--
  可选件：仿真雷达（Gazebo Classic）。不 include 就不存在，纯 RViz 看模型时不要用。

  Manifold Odin1 Lite 仿真替身：240×180、120°×90°、最高10 FPS、最小0.15 m。
  默认最大25 m（官方10%反射率、光照小于50 klux条件）；50 m仅对应
  90%反射率、光照小于500 lux。gpu_ray不模拟这些光学条件。
  不模拟940 nm、置信度、RGB、IMU或厂家SLAM；距离分辨率不是测距精度。
  官方第12章为240×180，第5章原始输出为256×192；此处采用名义深度分辨率，
  不宣称逐点兼容真实原始点云格式。详见 sentry_perception/README.md。
  https://manifoldtechltd.github.io/wiki/odin_series/odin1lite/12.%20Technical%20Specifications_.html
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Odin1 Lite 名义参数；均匀射线为仿真近似，不复现固件采样模式。 -->
  <xacro:property name="lidar_rate" value="10"/>              <!-- Hz；Lite最高10 FPS -->
  <xacro:property name="lidar_h_samples" value="240"/>        <!-- 120°/0.5° = 240 段 -->
  <xacro:property name="lidar_v_samples" value="180"/>        <!-- 90°/0.5° = 180 段 -->
  <xacro:property name="lidar_h_fov" value="1.0471975512"/>   <!-- 60° = π/3，水平半视场 -->
  <xacro:property name="lidar_v_min" value="-0.7853981634"/>  <!-- -45° = -π/4，垂直下沿 -->
  <xacro:property name="lidar_v_max" value="0.7853981634"/>   <!-- +45° = +π/4，垂直上沿 -->
  <xacro:property name="lidar_range_min" value="0.15"/>
  <xacro:property name="lidar_range_max" value="25.0"/>
  <!-- 43200射线/帧、432000采样/秒；官方点频约43万点/秒，不保证全部有效返回。 -->
  <!-- ================================================================ -->

  <gazebo reference="lidar_link">
    <sensor type="gpu_ray" name="odin1_lite">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>${lidar_rate}</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>${lidar_h_samples}</samples>
            <resolution>1</resolution>
            <min_angle>-${lidar_h_fov}</min_angle>
            <max_angle>${lidar_h_fov}</max_angle>
          </horizontal>
          <vertical>
            <samples>${lidar_v_samples}</samples>
            <resolution>1</resolution>
            <min_angle>${lidar_v_min}</min_angle>
            <max_angle>${lidar_v_max}</max_angle>
          </vertical>
        </scan>
        <range>
          <min>${lidar_range_min}</min>
          <max>${lidar_range_max}</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="lidar_ros" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=lidar/points</remapping>
        </ros>
        <output_type>sensor_msgs/PointCloud2</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
</robot>
