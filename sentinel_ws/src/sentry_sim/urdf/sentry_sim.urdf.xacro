<?xml version='1.0' encoding='utf-8'?>
<!--
  Gazebo Classic 专用外壳：引用纯模型，再追加材质、接触参数与两个自写插件。
  纯 RViz 看模型时不要用这个文件，用 sentry_description/urdf/sentry.urdf.xacro。
-->
<robot name="robovigor_sentry" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find sentry_description)/urdf/sentry.urdf.xacro"/>

  <!-- 所有零件统一灰色，避免 Gazebo 给每个网格随机配色 -->
  <xacro:macro name="gazebo_grey" params="link">
    <gazebo reference="${link}">
      <material>Gazebo/Grey</material>
    </gazebo>
  </xacro:macro>

  <!-- fdir1 沿圆柱局部 Z（轮轴）：沿轮轴低摩擦近似被动滚子自由度，圆周方向保留牵引。 -->
  <xacro:macro name="tire_surface" params="n">
    <gazebo reference="wheel_${n}_link">
      <material>Gazebo/Black</material>
      <mu1>0.001</mu1><mu2>0.9</mu2><fdir1>0 0 1</fdir1>
      <kp>100000</kp><kd>100</kd><minDepth>0.00005</minDepth>
      <maxVel>0.1</maxVel><maxContacts>8</maxContacts>
    </gazebo>
  </xacro:macro>

  <xacro:gazebo_grey link="chassis_link"/>
  <xacro:gazebo_grey link="gimbal_yaw_link"/>
  <xacro:tire_surface n="1"/>
  <xacro:tire_surface n="2"/>
  <xacro:tire_surface n="3"/>
  <xacro:tire_surface n="4"/>

  <!-- 两个自写插件挂在同一个 <gazebo> 下：
       云台力矩稳定（收 /spin_mode，发 /gimbal_pose）+ 四轮力矩驱动（/odom、/joint_states）。 -->
  <gazebo>
    <plugin name="sentry_gimbal_stabilizer" filename="libsentry_gimbal_stabilizer.so">
      <ros>
        <namespace>/</namespace>
      </ros>
    </plugin>
    <plugin name="sentry_omni_drive" filename="libsentry_omni_drive.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <wheel joint="wheel_1_joint">
        <radius>0.07610000042846267</radius>
      </wheel>
      <wheel joint="wheel_2_joint">
        <radius>0.07610000042846263</radius>
      </wheel>
      <wheel joint="wheel_3_joint">
        <radius>0.07610000042846263</radius>
      </wheel>
      <wheel joint="wheel_4_joint">
        <radius>0.07610000042845878</radius>
      </wheel>
    </plugin>
  </gazebo>

</robot>
