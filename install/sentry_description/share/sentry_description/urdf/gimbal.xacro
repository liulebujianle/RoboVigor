<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <link name="gimbal_yaw_link">
    <!-- 极简云台：转盘、立柱、上部支座；共用同一个云台关节。 -->
    <visual>
      <origin xyz="0 0 0.015"/>
      <geometry><cylinder radius="0.105" length="0.03"/></geometry>
      <material name="turret_gray"><color rgba="0.55 0.58 0.62 1"/></material>
    </visual>
    <visual>
      <origin xyz="0 0 0.10"/>
      <geometry><box size="0.045 0.045 0.17"/></geometry>
      <material name="turret_gray"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.19"/>
      <geometry><box size="0.16 0.12 0.08"/></geometry>
      <material name="turret_gray"/>
    </visual>
    <inertial>
      <origin xyz="0.032500 -0.001500 0.132000" />
      <mass value="2.0" />
      <inertia ixx="0.046279500" iyy="0.040310167" izz="0.055377667" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <joint name="gimbal_yaw_joint" type="continuous">
    <parent link="chassis_link" />
    <child link="gimbal_yaw_link" />
    <origin xyz="0 0 0.051" />
    <axis xyz="0 0 1" />
    <limit effort="200" velocity="20" />
    <dynamics damping="0" friction="0" />
  </joint>
</robot>