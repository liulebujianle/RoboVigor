<?xml version='1.0' encoding='utf-8'?>
<!-- 轻量全向底盘：保留 CAD 四轮 45° 布局，轮子用普通圆柱表达。
     方向摩擦近似滚子的侧向自由度，不创建独立滚子刚体。 -->
<robot name="robovigor_sentry" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================= 常量区 ================= -->
  <xacro:property name="wheel_mass" value="0.25"/>
  <xacro:property name="wheel_ixx" value="0.000251041666667"/>
  <xacro:property name="wheel_izz" value="0.000189583333333"/>
  <!-- 碰撞圆柱用滚子外缘半径 0.0761，和 omni_drive 插件里的 <radius> 一致，否则实际速度会慢 34% -->
  <xacro:property name="wheel_radius" value="0.0761"/>
  <xacro:property name="wheel_length" value="0.03979804608234"/>

  <xacro:macro name="cad_wheel" params="n xyz ax ay yaw">
    <xacro:property name="offset" value="-0.00150040329349"/>
    <xacro:property name="parallel" value="${wheel_mass * wheel_radius**2 / 2}"/>
    <xacro:property name="perpendicular" value="${wheel_mass * (3 * wheel_radius**2 + wheel_length**2) / 12}"/>
    <link name="wheel_${n}_link">
      <visual>
        <origin xyz="${ax*offset} ${ay*offset} 0" rpy="0 1.5707963267948966 ${yaw}"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_length}"/></geometry>
        <material name="rubber"><color rgba="0.08 0.08 0.08 1"/></material>
      </visual>
      <collision>
        <origin xyz="${ax*offset} ${ay*offset} 0" rpy="0 1.5707963267948966 ${yaw}"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_length}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="${ax*offset} ${ay*offset} 0"/>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${perpendicular + (parallel-perpendicular)*ax*ax}"
                 iyy="${perpendicular + (parallel-perpendicular)*ay*ay}"
                 izz="${perpendicular}"
                 ixy="${(parallel-perpendicular)*ax*ay}" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <joint name="wheel_${n}_joint" type="continuous">
      <parent link="chassis_link"/><child link="wheel_${n}_link"/>
      <origin xyz="${xyz}"/><axis xyz="${ax} ${ay} 0"/>
      <limit effort="1.2" velocity="1000"/>
      <dynamics damping="0.0001" friction="0"/>
    </joint>
  </xacro:macro>

  <!-- ================= 车体（单个实例，直接写死） ================= -->
  <link name="base_link"/>
  <joint name="chassis_fixed" type="fixed">
    <parent link="base_link"/>
    <child link="chassis_link"/>
  </joint>
  <link name="chassis_link">
    <visual>
      <origin xyz="0 0 -0.01"/>
      <geometry><box size="0.30 0.30 0.06"/></geometry>
      <material name="chassis_blue"><color rgba="0.12 0.28 0.48 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.30 0.30 0.08"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.013000"/>
      <mass value="6.5"/>
      <inertia ixx="0.179616667" iyy="0.179616667" izz="0.3159" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- 中心与轴线来自新装配体，单位 m/rad。 -->
  <xacro:cad_wheel n="1" xyz="-0.16731710127 0.16731710127 -0.0362828401707"
                   ax="0.7071067811865475" ay="-0.7071067811865475" yaw="-0.7853981633974483"/>
  <xacro:cad_wheel n="2" xyz="0.16731710127 0.16731710127 -0.0362828401707"
                   ax="-0.7071067811865475" ay="-0.7071067811865475" yaw="-2.356194490192345"/>
  <xacro:cad_wheel n="3" xyz="0.16731710127 -0.16731710127 -0.0362828401707"
                   ax="-0.7071067811865475" ay="0.7071067811865475" yaw="2.356194490192345"/>
  <xacro:cad_wheel n="4" xyz="-0.16731710127 -0.16731710127 -0.0362828401707"
                   ax="0.7071067811865475" ay="0.7071067811865475" yaw="0.7853981633974483"/>
</robot>
